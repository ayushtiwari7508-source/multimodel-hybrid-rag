# Copy this file to .env and set values locally. Do not commit .env.
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_BACKEND=cross-encoder
VISION_MODEL=llava:7b
ENABLE_VISION=false
VISION_ONLY_WHEN_NO_TEXT=true
ROUTER_MODEL=qwen2.5:3b
GENERAL_MODEL=qwen2.5:3b
CODE_MODEL=qwen2.5:3b
MATH_MODEL=qwen2.5:7b
FAST_MODEL=qwen2.5:3b
CHROMA_PERSIST_DIR=./data/chroma
BM25_PERSIST_PATH=./data/bm25/index.pkl
META_PERSIST_DIR=./data/index_meta
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_BM25=10
TOP_K_DENSE=10
TOP_K_RERANK=4
RRF_C=60
MAX_CONTEXT_TOKENS=4000
EMBED_BATCH_SIZE=64
SKIP_ROUTER=true
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
API_KEY=
RATE_LIMIT_PER_MIN=60
RAG_API_KEY=
